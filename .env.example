# Copy this file to .env at the repository root and replace this placeholder.
# Windows PowerShell: Copy-Item .env.example .env
# Linux/Colab: cp .env.example .env
#
# Path to the *dataset root* containing gold/ and silver/shards/.
# Example Windows (placeholder, not an actual personal Google Drive path):
# LIPSYNC_DATA_ROOT=G:/path/to/20261002_grid_dataset
# Example Colab:
# LIPSYNC_DATA_ROOT=/content/drive/MyDrive/path/to/20261002_grid_dataset
LIPSYNC_DATA_ROOT=PATH_TO_GRID_DATASET_ROOT

# Optional app settings. Change here, or override with OS environment variables.
# Leave LIPSYNC_MIN_FRAME_COUNT blank to keep all Gold samples (recommended for analysis).
LIPSYNC_FPS=25
LIPSYNC_FRAME_WIDTH=96
LIPSYNC_FRAME_HEIGHT=96
LIPSYNC_MIN_FRAME_COUNT=
# Example training-only quality filter: LIPSYNC_MIN_FRAME_COUNT=50
LIPSYNC_DURATION_GAP_THRESHOLD_MS=80
